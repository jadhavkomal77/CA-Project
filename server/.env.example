# Copy to .env and fill in. Never commit .env (it is gitignored).

# --- Required to boot ---
MONGO_URL=mongodb://127.0.0.1:27017/cadna
JWT_KEY=change-me-to-a-long-random-string
PORT=5001
# NOTE: port 5000 is taken by AirPlay Receiver on macOS — use 5001 locally.

# --- Required for ANY image/PDF upload (admin panel) ---
# Without these, every upload fails with "Must supply api_key".
# Values are in the Vercel server project → Settings → Environment Variables,
# or in your Cloudinary dashboard.
CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Required for forgot-password emails only ---
FROM_EMAIL=
EMAIL_PASS=

# Set by the host in production; leave unset locally so the server listens.
# NODE_ENV=production
